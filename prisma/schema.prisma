generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Listing {
  id                String   @id @default(cuid())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  userId            String?
  userEmail         String?
  title             String
  brand             String?
  model             String?
  category          String?
  ageYears          String?
  technicalCondition String?
  visualCondition   String?
  functionality     String?
  accessories       String?
  defects           String?
  reasonForSale     String?
  location          String?
  deliveryMethod    String?
  paymentMethod     String?
  originalPrice     String?
  desiredPrice      String?
  notes             String?
  photoUrls         Json?
  aiIdentification  Json?
  aiAnalysis        Json?
  priceResearch     Json?
  generatedListings Json?
  status            String   @default("rozpracovany")

  @@index([userId])
  @@map("listings")
}
